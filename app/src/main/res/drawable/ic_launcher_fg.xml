<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- 四节点网络图形(沿用 4.0 社区版图标意象) · 改进版 -->
    <!-- 几何:上中枢纽 + 左/右/下三节点,连成一个对称菱形环 -->

    <!-- 橙色节点的柔光晕 -->
    <path android:pathData="M78,58m-18,0a18,18 0,1 1,36 0a18,18 0,1 1,-36 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="78" android:centerY="58" android:gradientRadius="18">
                <item android:offset="0" android:color="#8CFFA445" />
                <item android:offset="0.5" android:color="#3DE8821E" />
                <item android:offset="1" android:color="#00E8821E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 连线:圆头圆角,半透明白 -->
    <path
        android:strokeColor="#CCFFFFFF" android:strokeWidth="4"
        android:strokeLineCap="round" android:strokeLineJoin="round"
        android:pathData="M48.5,36.5 L34.2,53.1 M59.5,36.5 L73.8,53.1 M34.9,62.3 L49.1,74.7 M73.1,62.3 L58.9,74.7" />

    <!-- 枢纽节点(大,珍珠质感) -->
    <path android:pathData="M54,30m-8.5,0a8.5,8.5 0,1 1,17 0a8.5,8.5 0,1 1,-17 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="51.2" android:centerY="27.2" android:gradientRadius="10">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.55" android:color="#FFDCEDFD" />
                <item android:offset="1" android:color="#FFA8CBEE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 左节点 -->
    <path android:pathData="M30,58m-6.5,0a6.5,6.5 0,1 1,13 0a6.5,6.5 0,1 1,-13 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="28.2" android:centerY="56.2" android:gradientRadius="7.6">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.6" android:color="#FFE2F0FE" />
                <item android:offset="1" android:color="#FFB4D4F2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右节点(强调色:橙) -->
    <path android:pathData="M78,58m-6.5,0a6.5,6.5 0,1 1,13 0a6.5,6.5 0,1 1,-13 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="76.2" android:centerY="56.2" android:gradientRadius="7.6">
                <item android:offset="0" android:color="#FFFFC078" />
                <item android:offset="0.55" android:color="#FFF39B3C" />
                <item android:offset="1" android:color="#FFE0711A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 下节点 -->
    <path android:pathData="M54,79m-6.5,0a6.5,6.5 0,1 1,13 0a6.5,6.5 0,1 1,-13 0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="52.2" android:centerY="77.2" android:gradientRadius="7.6">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.6" android:color="#FFE2F0FE" />
                <item android:offset="1" android:color="#FFB4D4F2" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
