<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">

    <!-- 底板:冷调对角渐变 #FFFFFF -> #E6F0FA -> #6FA6D2
         刻意做中间调:S 的上段是深藏青切面(需要浅底),
         下段是极浅冰蓝切面(需要中蓝底),两者才都读得出来。 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0" android:startY="0" android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FFFFFFFF" />
                <item android:offset="0.5" android:color="#FFE6F0FA" />
                <item android:offset="1" android:color="#FF6FA6D2" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右下淡青光,呼应 S 的青色切面 -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="94" android:centerY="97" android:gradientRadius="56">
                <item android:offset="0" android:color="#4D5FD0DC" />
                <item android:offset="0.6" android:color="#1E5FD0DC" />
                <item android:offset="1" android:color="#005FD0DC" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
